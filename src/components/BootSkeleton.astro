---
// The "ghost panel" shown while a page loads: translucent blocks in the shape
// of the page that's about to appear (nav, title, credit, media…), sweeping
// with a faint highlight. It sits over the real page until fonts, images and
// scripts are ready, then dissolves block by block as the real content comes
// in — so a visitor reads "loading", not "badly built".
//
// It is only visible while <html data-boot> is set (see the script in
// Layout.astro), so without JavaScript the page simply shows as normal.
interface Props {
  variant?: "home" | "work" | "project" | "about" | "contact" | "notfound";
}
const { variant = "project" } = Astro.props;

// A running index: each block's shimmer and exit are offset from the last one,
// which makes the highlight roll through the page instead of flashing it.
let n = 0;
const i = () => `--i:${n++}`;
const times = (count: number) => Array.from({ length: count });
---

<div class="boot" aria-hidden="true" data-variant={variant}>
  <div class="wrap boot-nav">
    <span class="sk sk-mark" style={i()}></span>
    <span class="boot-right">
      <span class="boot-links">
        {times(3).map(() => <span class="sk sk-link" style={i()} />)}
      </span>
      <span class="boot-langs">
        {times(3).map(() => <span class="sk sk-lang" style={i()} />)}
      </span>
    </span>
  </div>

  {
    variant === "home" && (
      <>
        <span class="sk boot-frame" style={i()} />
        <div class="boot-stage">
          <div class="wrap boot-hero">
            <span class="sk sk-hero-line sk-one" style={i()} />
            <span class="sk sk-hero-line sk-two" style={i()} />
          </div>
        </div>
        <div class="wrap boot-cue">
          <span class="sk sk-cue" style={i()} />
        </div>
        <div class="boot-rail">
          {times(6).map(() => <span class="sk sk-tick" style={i()} />)}
        </div>
      </>
    )
  }

  {
    variant === "work" && (
      <div class="wrap boot-page">
        <span class="sk sk-work-heading" style={i()} />
        <div class="boot-grid">
          {times(2).map((_, col) => (
            <div class:list={["boot-col", { "sk-off": col === 1 }]}>
              {times(2).map((_, row) => (
                <div class="boot-card">
                  <span class="sk sk-card-frame" style={`${i()};--ar:${(col + row) % 2 ? "4 / 3" : "16 / 10"}`} />
                  <span class="sk sk-card-title" style={i()} />
                  <span class="sk sk-card-sub" style={i()} />
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    variant === "project" && (
      <>
        <div class="wrap boot-page boot-head">
          <span class="sk sk-eyebrow" style={i()} />
          <span class="sk sk-title" style={i()} />
          <span class="sk sk-artist" style={i()} />
          <span class="sk sk-rule" style={i()} />
          <span class="sk sk-credit" style={i()} />
        </div>
        <span class="sk boot-media" style={i()} />
      </>
    )
  }

  {
    variant === "about" && (
      <div class="wrap boot-page boot-about">
        <span class="sk sk-portrait" style={i()} />
        <div class="boot-text">
          {["100%", "96%", "92%", "99%", "58%", "100%", "94%", "97%", "88%", "46%"].map((w) => (
            <span class="sk sk-line" style={`${i()};width:${w}`} />
          ))}
        </div>
      </div>
    )
  }

  {
    variant === "contact" && (
      <>
        <span class="sk boot-frame" style={i()} />
        <div class="boot-stage">
          <div class="wrap boot-low">
            <span class="sk sk-big" style={`${i()};width:74%`} />
            <span class="sk sk-big" style={`${i()};width:44%`} />
            <span class="sk sk-big" style={`${i()};width:36%`} />
            <span class="sk sk-small" style={i()} />
          </div>
        </div>
      </>
    )
  }

  {
    variant === "notfound" && (
      <>
        <span class="sk boot-frame" style={i()} />
        <div class="boot-stage">
          <div class="wrap boot-low">
            <span class="sk sk-code" style={i()} />
            <span class="sk sk-nf-title" style={i()} />
            <span class="sk sk-nf-text" style={i()} />
            <span class="sk sk-nf-cta" style={i()} />
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  /* ---- the overlay itself ------------------------------------------------ */
  .boot {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: hidden;
    background: var(--bg, #000);
    cursor: progress;
  }

  :global(html[data-boot]) .boot {
    display: block;
  }

  /* No scrolling the page behind the overlay. */
  :global(html[data-boot]) {
    overflow: hidden;
  }

  /* Escape hatch that needs no JavaScript: if the script that lifts the
     overlay ever failed, the overlay removes itself after a few seconds. */
  :global(html[data-boot="on"]) .boot {
    animation: boot-failsafe 0s linear 8s forwards;
  }

  @keyframes boot-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Leaving: the dark ground clears while the blocks dissolve one after
     another, top to bottom, as the real content takes their place. */
  :global(html[data-boot="leaving"]) .boot {
    background: transparent;
    pointer-events: none;
    transition: background-color 0.7s ease 0.15s;
  }

  /* ---- a block ------------------------------------------------------------ */
  .sk {
    position: relative;
    display: block;
    overflow: hidden;
    background: rgba(242, 242, 239, 0.085);
    border: 1px solid rgba(242, 242, 239, 0.14);
  }

  .sk::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 20%, rgba(242, 242, 239, 0.16) 50%, transparent 80%);
    transform: translateX(-100%);
    animation: boot-sweep 1.8s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  @keyframes boot-sweep {
    to {
      transform: translateX(100%);
    }
  }

  :global(html[data-boot="leaving"]) .sk {
    opacity: 0;
    transform: translateY(-8px);
    border-color: transparent;
    transition:
      opacity 0.5s ease calc(var(--i, 0) * 35ms),
      transform 0.7s ease calc(var(--i, 0) * 35ms),
      border-color 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .sk::after {
      animation: none;
    }

    :global(html[data-boot="leaving"]) .sk {
      transform: none;
      transition-duration: 0.2s;
      transition-delay: 0s;
    }

    :global(html[data-boot="leaving"]) .boot {
      transition-duration: 0.2s;
      transition-delay: 0s;
    }
  }

  /* ---- navigation (every page) ------------------------------------------- */
  .boot-nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
  }

  .sk-mark {
    width: 9.5rem;
    height: 1.4rem;
  }

  .boot-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .boot-links,
  .boot-langs {
    display: flex;
    align-items: center;
  }

  .boot-links {
    gap: 2rem;
  }

  .boot-langs {
    gap: 0.5rem;
  }

  .sk-link {
    width: 3.6rem;
    height: 1rem;
  }

  .sk-lang {
    width: 1.3rem;
    height: 0.8rem;
  }

  @media (max-width: 600px) {
    .boot-nav {
      flex-wrap: wrap;
      row-gap: 0.85rem;
    }

    .boot-right {
      flex-basis: 100%;
      justify-content: space-between;
      gap: 1rem;
    }

    .boot-links {
      gap: 1.25rem;
    }

    .sk-link {
      width: 3rem;
    }
  }

  /* ---- shared: a full-bleed frame with text low on the left -------------- */
  .boot-frame {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(242, 242, 239, 0.045);
  }

  .boot-stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .boot-stage .wrap {
    width: 100%;
  }

  .boot-low {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-bottom: clamp(2rem, 7vh, 4.5rem);
  }

  /* ---- home ---------------------------------------------------------------- */
  .boot-hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: clamp(4.5rem, 14vh, 8rem);
    --hero-size: clamp(2.6rem, 6.4vw, 6rem);
  }

  .sk-hero-line {
    height: calc(var(--hero-size) * 0.74);
  }

  .sk-hero-line.sk-one {
    width: min(88%, 64rem);
  }

  .sk-hero-line.sk-two {
    width: min(64%, 46rem);
  }

  .boot-cue {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.75rem;
  }

  .sk-cue {
    width: 4.4rem;
    height: 0.7rem;
  }

  .boot-rail {
    position: absolute;
    right: var(--gutter, 3rem);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .sk-tick {
    width: 1.1rem;
    height: 2px;
    border: 0;
  }

  /* ---- work ------------------------------------------------------------------ */
  .boot-page {
    position: relative;
    z-index: 1;
  }

  .sk-work-heading {
    width: min(30rem, 72%);
    height: clamp(2.4rem, 5vw, 3.8rem);
    margin: 3rem 0 2.5rem;
  }

  .boot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .boot-col {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .boot-col.sk-off {
    margin-top: 6rem;
  }

  .boot-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .sk-card-frame {
    width: 100%;
    aspect-ratio: var(--ar, 16 / 10);
  }

  .sk-card-title {
    width: 52%;
    height: 1.4rem;
  }

  .sk-card-sub {
    width: 28%;
    height: 0.8rem;
  }

  @media (max-width: 720px) {
    .boot-grid {
      grid-template-columns: 1fr;
    }

    .boot-col.sk-off {
      display: none;
    }
  }

  /* ---- project ---------------------------------------------------------------- */
  .boot-head {
    display: flex;
    flex-direction: column;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  .sk-eyebrow {
    width: 7rem;
    height: 0.75rem;
  }

  .sk-title {
    width: min(26rem, 62%);
    height: calc(clamp(3.2rem, 7vw, 5.2rem) * 0.78);
    margin-top: 0.8rem;
  }

  .sk-artist {
    width: 11rem;
    height: 1.15rem;
    margin-top: 0.8rem;
  }

  .sk-rule {
    width: 100%;
    height: 1px;
    margin-top: 1.75rem;
    border: 0;
    background: rgba(242, 242, 239, 0.2);
  }

  .sk-credit {
    width: min(30rem, 74%);
    height: calc(clamp(1.4rem, 2.8vw, 2.1rem) * 0.8);
    margin-top: 1.1rem;
  }

  .boot-media {
    width: min(100%, calc(85vh * 16 / 9));
    aspect-ratio: 16 / 9;
    margin: 0 auto;
  }

  /* ---- about ------------------------------------------------------------------- */
  .boot-about {
    display: grid;
    grid-template-columns: minmax(220px, 360px) 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: 3rem;
  }

  .sk-portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  .boot-text {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    max-width: 46rem;
  }

  .sk-line {
    height: 1.05rem;
  }

  @media (max-width: 900px) {
    .boot-about {
      grid-template-columns: 1fr;
    }

    .sk-portrait {
      max-width: 300px;
    }
  }

  /* ---- contact / 404 ------------------------------------------------------------- */
  .sk-big {
    height: calc(clamp(1.7rem, 4.6vw, 4rem) * 0.8);
  }

  .sk-small {
    width: 10rem;
    height: 0.8rem;
    margin-top: 0.6rem;
  }

  .sk-code {
    width: clamp(10rem, 36vw, 26rem);
    height: calc(clamp(7rem, 26vw, 19rem) * 0.7);
  }

  .sk-nf-title {
    width: min(26rem, 70%);
    height: 2.6rem;
    margin-top: 0.4rem;
  }

  .sk-nf-text {
    width: min(22rem, 64%);
    height: 1rem;
  }

  .sk-nf-cta {
    width: 8rem;
    height: 1.1rem;
    margin-top: 0.6rem;
  }
</style>
