---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { t, ui, type Locale } from "../i18n/ui";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  footerFlush?: boolean;
  noFooter?: boolean;
  overlayNav?: boolean;
}

const {
  title,
  locale,
  description = t(ui.meta.description, locale),
  footerFlush = false,
  noFooter = false,
  overlayNav = false,
} = Astro.props;

const pageTitle = `${title} - Èric Camacho`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`/og-${locale}.jpg`, Astro.site);
const ogLocales: Record<Locale, string> = { ca: "ca_ES", es: "es_ES", en: "en_US" };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The ?v= suffix is deliberate: browsers cache favicons by URL and keep
         showing the old one for weeks. Bump it whenever the icons change. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest?v=2" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Èric Camacho" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocales[locale]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-title" content="Èric Camacho" />
    <link rel="preload" href="/fonts/archivo/Archivo-VF.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <Nav locale={locale} overlay={overlayNav} />
    <main>
      <slot />
    </main>
    {!noFooter && <Footer locale={locale} flush={footerFlush} />}
  </body>
</html>
