---
import Layout from "../layouts/Layout.astro";
import { locales, defaultLocale, t, ui } from "../i18n/ui";

// A static host serves this one file for every URL it can't match, so there
// is no locale at build time. The page is built in the default locale (what
// a visitor without JavaScript sees) and carries the other two languages in
// hidden blocks; the script below picks one from the URL ("/es/loquesea")
// or, failing that, from the browser's language.
const locale = defaultLocale;
const navLabels = Object.fromEntries(
  locales.map((l) => [l, [t(ui.nav.work, l), t(ui.nav.about, l), t(ui.nav.contact, l)]]),
);
---

<Layout skeleton="notfound" title="404" locale={locale} description={t(ui.notFound.body, locale)} noFooter overlayNav>
  <section class="frame">
    <img src="/images/gasolina/still-1.jpg" alt="" class="frame-bg" />
    <div class="frame-shade"></div>

    <div class="wrap frame-content">
      <p class="code" aria-hidden="true">404</p>
      {
        locales.map((l) => (
          <div data-lang={l} hidden={l !== locale}>
            <h1>{t(ui.notFound.heading, l)}</h1>
            <p class="body">{t(ui.notFound.body, l)}</p>
            <a href={`/${l}/`} class="cta link-underline">
              {t(ui.notFound.cta, l)}
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<script define:vars={{ navLabels }}>
  (function () {
    var locales = ["ca", "es", "en"];
    var first = location.pathname.split("/").filter(Boolean)[0];
    var loc = locales.indexOf(first) > -1 ? first : null;
    if (!loc) {
      var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
      for (var i = 0; i < langs.length && !loc; i++) {
        var short = String(langs[i]).slice(0, 2).toLowerCase();
        if (locales.indexOf(short) > -1) loc = short;
      }
    }
    loc = loc || "ca";

    document.documentElement.lang = loc;
    document.querySelectorAll("[data-lang]").forEach(function (el) {
      el.hidden = el.getAttribute("data-lang") !== loc;
    });

    // The nav was rendered in the default locale — point it at the chosen one.
    var paths = ["/work", "/about", "/contact"];
    document.querySelectorAll(".nav .links a").forEach(function (a, i) {
      a.textContent = navLabels[loc][i];
      a.setAttribute("href", "/" + loc + paths[i]);
    });
    var wordmark = document.querySelector(".nav .wordmark");
    if (wordmark) wordmark.setAttribute("href", "/" + loc + "/");
    document.querySelectorAll(".nav .lang-link").forEach(function (a, i) {
      var active = locales[i] === loc;
      // There is no translated version of an unknown URL — go to that language's home.
      a.setAttribute("href", "/" + locales[i] + "/");
      a.classList.toggle("is-active", active);
      if (active) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  })();
</script>

<style>
  /* Same full-bleed frame as the contact page: one image, the message
     low-left in the poster voice. */
  .frame {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100dvh;
    padding-bottom: clamp(2rem, 7vh, 4.5rem);
    overflow: hidden;
  }

  .frame-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  .frame-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.45) 45%,
      rgba(0, 0, 0, 0.1) 75%,
      rgba(0, 0, 0, 0.4) 100%
    );
  }

  .frame-content {
    position: relative;
    width: 100%;
  }

  .code {
    margin: 0;
    font-family: var(--font-title);
    font-stretch: 64%;
    font-weight: 800;
    font-size: clamp(7rem, 26vw, 19rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 5vw, 3.6rem);
  }

  .body {
    text-transform: none;
    margin: 0.75rem 0 0;
    max-width: 38ch;
    color: var(--fg-muted);
    font-size: 1.05rem;
  }

  .cta {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 1.15rem;
  }
</style>
