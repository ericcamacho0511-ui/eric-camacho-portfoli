---
import Layout from "../layouts/Layout.astro";
import { t, ui } from "../i18n/ui";

// No real locale context for an unmatched route, so this falls back to
// the site's default locale rather than trying to guess one.
const locale = "ca" as const;
---

<Layout title="404" locale={locale} description={t(ui.notFound.body, locale)}>
  <section class="wrap head">
    <p class="eyebrow">{t(ui.notFound.eyebrow, locale)}</p>
    <p class="code font-title">404</p>
    <h1>{t(ui.notFound.heading, locale)}</h1>
    <p class="body">{t(ui.notFound.body, locale)}</p>
    <a href="/ca/" class="cta link-underline font-display">{t(ui.notFound.cta, locale)}</a>
  </section>
</Layout>

<style>
  .head {
    padding-top: 4rem;
    padding-bottom: 8rem;
    max-width: 640px;
  }

  .code {
    color: var(--title);
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    margin-top: 1rem;
  }

  .head h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin-top: 1.5rem;
  }

  .body {
    margin-top: 1rem;
    color: var(--fg-muted);
    font-size: 1.1rem;
    max-width: 38ch;
  }

  .cta {
    display: inline-block;
    margin-top: 2.5rem;
    font-size: 1.25rem;
  }
</style>
