---
import Layout from "../../layouts/Layout.astro";
import { locales, t, ui, type Locale } from "../../i18n/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<Layout title="About" locale={locale}>
  <section class="wrap head">
    <img src="/images/about/eric.jpg" alt="Èric Camacho" class="portrait" data-reveal />

    <div class="intro">
      <h1>Èric Camacho</h1>

      <div class="bio font-display">
        {ui.about.bio.map((paragraph) => (
          <p data-reveal>{t(paragraph, locale)}</p>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { setupReveal } from "../../lib/reveal";
  document.addEventListener("astro:page-load", setupReveal);
</script>

<style>
  .head {
    padding-top: 3rem;
    padding-bottom: 6rem;
    display: grid;
    grid-template-columns: minmax(220px, 360px) 1fr;
    gap: 4rem;
    align-items: start;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
  }

  .head h1 {
    font-size: clamp(2.8rem, 6.5vw, 4.6rem);
  }

  .bio {
    text-transform: none;
    max-width: 46rem;
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-size: 1.4rem;
    line-height: 1.55;
    font-weight: 400;
  }

  /* Portrait tablets are too narrow to hold the photo and a readable bio
     side by side, so the photo stacks above the text up to 900px. */
  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .portrait {
      max-width: 300px;
    }
  }
</style>
