---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { locales, t, ui, typeLabel, roleLabel, type Locale } from "../../i18n/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const allWork = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Home" locale={locale} noFooter>
  <div class="stage" id="stage">
    <div class="stage-track" id="stage-track">
      <section class="slide hero-slide">
        <div class="wrap">
          <h1 class="hero-title">{t(ui.home.heroTitle, locale)}</h1>
        </div>
        <div class="scroll-cue" aria-hidden="true">
          <span class="scroll-cue-label">{t(ui.home.scrollCue, locale)}</span>
          <svg class="scroll-cue-arrow" viewBox="0 0 16 9" fill="none">
            <path d="M1 1l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </section>

      {
        allWork.map((project) => {
          const { bgVideo, stills, cover, title } = project.data;
          const useSlider = !bgVideo && stills.length > 1;
          return (
            <a href={`/${locale}/work/${project.id}`} class="slide reel-section">
              {bgVideo ? (
                <video
                  class="reel-bg"
                  src={bgVideo}
                  poster={cover}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  data-hover-video
                />
              ) : useSlider ? (
                <div class="reel-slider">
                  {stills.map((still, i) => (
                    <img
                      src={still}
                      alt={title}
                      class="reel-bg slide"
                      class:list={[{ "is-active": i === 0 }]}
                    />
                  ))}
                </div>
              ) : (
                <img src={cover} alt={title} class="reel-bg" />
              )}
              <div class="reel-overlay" />
              <div class="reel-content wrap">
                <span class="reel-title font-display">{title}</span>
                <span class="reel-meta">
                  {typeLabel(project.data.type, locale)} · {roleLabel(project.data.role, locale)} ·{" "}
                  {project.data.year}
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  import { setupScrollStage, teardownScrollStage } from "../../lib/scrollStage";

  // Anyone who's told the OS they prefer reduced motion doesn't get the
  // continuous slide crossfade, the hover-triggered video loop, or the
  // locked one-screen-per-project scroll — all three are ambient/forced
  // motion, not something the user asked to happen.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Cross-fades the still images inside any .reel-slider — used for
  // photo-only projects (e.g. a photobook) that have no background video.
  // Re-runs on "astro:page-load" (fires on first load AND after every
  // client-side page transition) so it still finds and binds to the
  // reel-sliders when you navigate back to Home via the ClientRouter,
  // since that swap doesn't re-execute this script on its own.
  document.addEventListener("astro:page-load", () => {
    if (reduceMotion) return;
    document.querySelectorAll<HTMLElement>(".reel-slider").forEach((slider) => {
      const slides = slider.querySelectorAll<HTMLElement>(".slide");
      if (slides.length < 2 || slider.dataset.crossfadeBound) return;
      slider.dataset.crossfadeBound = "true";
      let index = 0;
      setInterval(() => {
        slides[index].classList.remove("is-active");
        index = (index + 1) % slides.length;
        slides[index].classList.add("is-active");
      }, 3200);
    });
  });

  // Cover videos only play while the mouse is over that section — muted,
  // looping, and reset back to the poster frame on mouse-out. Delegated on
  // document (rather than attached per-section) so it keeps working even
  // if the reel markup gets swapped out after this script first runs.
  // Skipped once the locked scroll-stage is active (below): with one slide
  // visible at a time, a real cursor can still wander off it (e.g. onto
  // the nav) without that meaning "not looking at this project anymore",
  // and there's no cursor at all on touch devices — slide activation
  // drives playback there instead.
  document.addEventListener("mouseover", (e) => {
    if (reduceMotion || document.documentElement.classList.contains("scroll-stage")) return;
    const section = (e.target as HTMLElement).closest<HTMLElement>(".reel-section");
    if (!section || section.contains(e.relatedTarget as Node)) return;
    section.querySelector<HTMLVideoElement>("[data-hover-video]")?.play().catch(() => {});
  });

  document.addEventListener("mouseout", (e) => {
    if (document.documentElement.classList.contains("scroll-stage")) return;
    const section = (e.target as HTMLElement).closest<HTMLElement>(".reel-section");
    if (!section || section.contains(e.relatedTarget as Node)) return;
    const video = section.querySelector<HTMLVideoElement>("[data-hover-video]");
    if (!video) return;
    video.pause();
    video.currentTime = 0;
  });

  // While the scroll-stage is locked, a project's cover video plays for as
  // long as — and only while — its slide is the one on screen, so it works
  // identically on a trackpad and on a phone with no cursor at all.
  document.addEventListener("astro:page-load", () => {
    const stage = document.querySelector<HTMLElement>("#stage");
    if (!stage || stage.dataset.videoBound) return;
    stage.dataset.videoBound = "true";
    stage.addEventListener("slidechange", ((e: CustomEvent<{ index: number; previousIndex: number }>) => {
      if (reduceMotion) return;
      const slides = document.querySelectorAll<HTMLElement>("#stage-track > .slide");
      const prevVideo = slides[e.detail.previousIndex]?.querySelector<HTMLVideoElement>("[data-hover-video]");
      if (prevVideo) {
        prevVideo.pause();
        prevVideo.currentTime = 0;
      }
      slides[e.detail.index]?.querySelector<HTMLVideoElement>("[data-hover-video]")?.play().catch(() => {});
    }) as EventListener);
  });

  document.addEventListener("astro:page-load", setupScrollStage);
  document.addEventListener("astro:before-swap", teardownScrollStage);
</script>

<style>
  .stage {
    position: relative;
  }

  .slide {
    min-height: 100dvh;
  }

  .hero-slide {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--bg);
  }

  .hero-title {
    font-size: clamp(2.8rem, 6.5vw, 4.6rem);
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg-muted);
  }

  .scroll-cue-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: lowercase;
  }

  .scroll-cue-arrow {
    width: 16px;
    height: 9px;
    animation: scroll-cue-bounce 1.8s ease-in-out infinite;
  }

  @keyframes scroll-cue-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(5px);
      opacity: 1;
    }
  }

  .reel-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    color: #f5f2ea;
    text-decoration: none;
    overflow: hidden;
  }

  .reel-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .reel-section:hover .reel-bg {
    transform: scale(1.04);
  }

  .reel-slider {
    position: absolute;
    inset: 0;
  }

  .reel-slider .slide {
    position: absolute;
    min-height: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .reel-slider .slide.is-active {
    opacity: 1;
  }

  .reel-overlay {
    position: absolute;
    inset: 0;
    /* Even, center-weighted darkening — the title sits in the middle of
       the frame rather than anchored to the bottom, so it needs contrast
       there instead of just along the lower edge. */
    background: radial-gradient(ellipse at center, rgba(15, 13, 10, 0.5) 0%, rgba(15, 13, 10, 0.3) 65%, rgba(15, 13, 10, 0.4) 100%);
  }

  .reel-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .reel-title {
    font-family: var(--font-title);
    font-size: clamp(3.5rem, 11vw, 8.5rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .reel-meta {
    font-size: clamp(0.85rem, 1vw, 1rem);
    letter-spacing: 0.04em;
    text-transform: lowercase;
    opacity: 0.85;
  }

  /* Locked, one-screen-per-project presentation — added by scrollStage.ts
     only when JS has run and the visitor doesn't prefer reduced motion.
     Without this class the slides above are just a normal tall page. */
  :global(html.scroll-stage) body {
    height: 100dvh;
    overflow: hidden;
  }

  :global(html.scroll-stage) .stage {
    position: fixed;
    top: var(--nav-h, 0px);
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
  }

  :global(html.scroll-stage) .stage-track {
    height: 100%;
    transition: transform 0.85s cubic-bezier(0.645, 0.045, 0.355, 1);
    will-change: transform;
  }

  :global(html.scroll-stage) .slide {
    height: 100%;
    min-height: 0;
  }
</style>
